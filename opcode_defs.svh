`ifndef OPCODE_DEFS_SVH
`define OPCODE_DEFS_SVH

localparam logic [7:0]
    NOP    = 8'h00,
    RET    = 8'h01,
    BRnzp  = 8'h02,
    LDR    = 8'h03,
    STR    = 8'h04,
    CONST  = 8'h05,
    CMP    = 8'h06,
    ADD    = 8'h07,
    SUB    = 8'h08,
    MUL    = 8'h09,
    DIV    = 8'h0A,
    REM    = 8'h0B,
    NOT    = 8'h0C,
    AND    = 8'h0D,
    OR     = 8'h0E,
    XOR    = 8'h0F,
    NOTL   = 8'h10,
    ANDL   = 8'h11,
    ORL    = 8'h12,
    SLL    = 8'h13,
    SRL    = 8'h14,
    ADDFP  = 8'h15,
    MULFP  = 8'h16,
    ADDI   = 8'h17,
    SUBI   = 8'h18,
    MULI   = 8'h19,
    DIVI   = 8'h1A,
    REMI   = 8'h1B,
    NOTI   = 8'h1C,
    ANDI   = 8'h1D,
    ORI    = 8'h1E,
    XORI   = 8'h1F,
    SLLI   = 8'h20,
    SRLI   = 8'h21;

`endif
